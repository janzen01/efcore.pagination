<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- The EF Core version here becomes the floor all four packages advertise, because transitive
       pinning propagates it into every nuspec. Tracking the latest 11.x release is
       deliberate, not an artifact of whatever the last build used: the 11.x line pairs with .NET 11
       and EF Core 11 by design, so a consumer of these packages is on that line already. The cost is
       real and accepted - someone pinned to an earlier 11.0.x build for their own reasons has to move
       their whole EF Core closure - and the alternative, flooring at the engine's true minimum, means
       establishing that minimum empirically and holding a CI leg on it.
       The range is capped below the next major, the way Npgsql.EntityFrameworkCore.PostgreSQL caps its
       own: a net11.0 engine loaded against EF Core 12 can fail at runtime, and with the cap a restore
       that resolves EF Core 12.0.0 or later reports NU1608 instead of saying nothing. It does not cover
       the next major's prereleases: NuGet orders 12.0.0-rc.N below 12.0.0, so a project on the EF Core 12
       release candidates resolves this line without a word (measured on the 10.x line). The bound that
       would cover them, 12.0.0-0, is itself a prerelease, and NuGet refuses that in a stable package
       (NU5104). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[11.0.0-rc.1.26425.128, 12.0.0)" />
    <!-- Nothing in the tree references Relational directly, so without this entry it settles on
         Npgsql.EntityFrameworkCore.PostgreSQL's own floor while the core project raises
         Microsoft.EntityFrameworkCore itself - a Core / Relational pairing EF Core's
         own packages never produce, and one nothing warns about because every declared range is
         satisfied. Transitive pinning only applies to packages that have an entry here, which is why
         the split has to be closed by naming it. It is promoted to a visible dependency of the
         PostgreSql package as a result; that is the cost of holding the family together. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[11.0.0-rc.1.26425.128, 12.0.0)" />
    <PackageVersion Include="NodaTime" Version="3.3.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <!-- Test-only. Sqlite tracks the same EF Core version as the engine. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[11.0.0-rc.1.26425.128, 12.0.0)" />
    <!-- Transitive pin: a floor at 2.1.12, the first release outside GHSA-2m69-gcr7-jv3q's affected
         range (<= 2.1.11, a high-severity advisory in the bundled SQLite). EF Core's Sqlite provider
         resolves 2.1.12 on its own at the version pinned above, so the pin is belt-and-braces today
         and blocks a downgrade should a future provider relax its own floor. Do not raise it: 2.1.12
         is exactly EF Core's floor, and diverging means testing a native build it does not ship
         against. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>