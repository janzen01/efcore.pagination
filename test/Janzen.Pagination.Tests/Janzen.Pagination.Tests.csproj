<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Also opts the project out of PublicApiAnalyzers and out of packing the README/icon:
             both ItemGroups in Directory.Build.props are conditioned on IsPackable != false. -->
        <IsPackable>false</IsPackable>
        <!-- Package validation is enabled centrally, where a PropertyGroup cannot be conditioned on IsPackable
             (Directory.Build.props is evaluated before this body). Left on, the baseline lookup would go
             looking for a released Janzen.Pagination.Tests package, which has never existed. -->
        <EnablePackageValidation>false</EnablePackageValidation>
        <!-- Missing XML doc comments. Enforced for the packable projects (their .xml ships to consumers), but this
             assembly has no consumers, so documenting test members would be noise. Scoped here rather than in
             Directory.Build.props so a new undocumented public member in src/ still fails the build. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- AddOpenApi's XML-comment source generator emits interceptors, which the compiler refuses to
             accept until their namespace is opted in. Only this project hosts an app, so only it needs it. -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <!-- The engine has three process-wide mutable statics (PaginateLikeDefaults.Strategy, PaginateTypeSupport's
             registries, PaginateConfigDefaults.Shared), and a [Collection] cannot isolate a test that assigns one:
             xunit serialises within a collection but runs different collections in parallel. Shared is read by every
             Build() in the assembly, so a test asserting the engine's own defaults would fail whenever it happened to
             run alongside one that had raised them. The suite is ~2s either way. -->
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <!-- DefaultHttpContext, ExceptionContext, WebApplication for the ASP.NET Core tests. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Janzen.Pagination.EntityFrameworkCore\Janzen.Pagination.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.AspNetCore\Janzen.Pagination.AspNetCore.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.PostgreSql\Janzen.Pagination.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.NodaTime\Janzen.Pagination.NodaTime.csproj"/>
    </ItemGroup>

</Project>
