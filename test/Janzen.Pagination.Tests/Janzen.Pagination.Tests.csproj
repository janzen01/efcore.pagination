<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Also opts the project out of PublicApiAnalyzers and out of packing the README/icon:
             both ItemGroups in Directory.Build.props are conditioned on IsPackable != false. -->
        <IsPackable>false</IsPackable>
        <!-- Missing XML doc comments. Enforced for the packable projects (their .xml ships to consumers), but this
             assembly has no consumers, so documenting test members would be noise. Scoped here rather than in
             Directory.Build.props so a new undocumented public member in src/ still fails the build. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- AddOpenApi's XML-comment source generator emits interceptors, which the compiler refuses to
             accept until their namespace is opted in. Only this project hosts an app, so only it needs it. -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <!-- DefaultHttpContext, ExceptionContext, WebApplication for the ASP.NET Core tests. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Janzen.Pagination.EntityFrameworkCore\Janzen.Pagination.EntityFrameworkCore.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.AspNetCore\Janzen.Pagination.AspNetCore.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.PostgreSql\Janzen.Pagination.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\Janzen.Pagination.NodaTime\Janzen.Pagination.NodaTime.csproj"/>
    </ItemGroup>

</Project>
