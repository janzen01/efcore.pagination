# vitepress-plugin-mermaid puts mermaid's own transitive dependencies (@braintree/sanitize-url, dayjs,
# debug, cytoscape, cytoscape-cose-bilkent) into Vite's optimizeDeps.include, and Vite resolves those from
# the project root. pnpm's default layout keeps them nested under .pnpm, so the dev server logs
# "Failed to resolve dependency" for each one, the client bundle never finishes, and `pnpm docs:dev`
# renders a blank page -- while `pnpm docs:build` succeeds, which makes it a confusing failure to meet.
#
# Hoisting is the accepted fix for a leaf project like this: nothing here is published, so the strictness
# pnpm buys elsewhere has nothing to protect.
shamefully-hoist=true
