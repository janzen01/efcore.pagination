{
  "name": "@janzen01/efcore.pagination-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for Janzen.Pagination, published to GitHub Pages.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "docs:dev": "node scripts/sync-archive.mjs && vitepress dev",
    "docs:test": "node --test scripts/sync-archive.test.mjs",
    "docs:build": "pnpm docs:test && node scripts/sync-archive.mjs && vitepress build && node scripts/verify-frozen-urls.mjs && node scripts/verify-anchors.mjs",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.21.1",
    "@viteplus/versions": "^2.3.0",
    "mermaid": "^12.2.0",
    "picomatch": "^4.0.7",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1"
    }
  }
}
