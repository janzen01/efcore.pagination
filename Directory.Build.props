<Project>

    <!-- Compilation -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Code quality -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Public library: missing XML doc comments must not fail the build (yet) -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- Audit transitive dependencies too, not just direct ones (the default). -->
        <NuGetAuditMode>all</NuGetAuditMode>
    </PropertyGroup>

    <!-- Package identity (PackageId and Description are set per project) -->
    <PropertyGroup>
        <Version>0.9.0</Version>
        <Product>Janzen.Pagination</Product>
        <Authors>Lubos Jansky</Authors>
        <Copyright>Copyright © Lubos Jansky</Copyright>
    </PropertyGroup>

    <!-- Source control / Source Link (defines RepositoryUrl used below) -->
    <PropertyGroup>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/janzen01/efcore.pagination</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <!-- Deterministic source-path normalization for CI builds (.NET SDK has built-in SourceLink for GitHub). -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Package metadata (NuGet listing) -->
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/janzen01/efcore.pagination</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>$(RepositoryUrl)/releases</PackageReleaseNotes>
        <PackageTags>pagination;filtering;sorting;efcore;entity-framework-core;linq;query</PackageTags>
    </PropertyGroup>

    <!-- Package output (symbols) -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- Packaging: each packable project ships its own README.md as the NuGet readme -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!--
      Public API tracking: the declared surface lives in PublicAPI.Shipped.txt (released) and
      PublicAPI.Unshipped.txt (added since). Adding a public member fails the build until it is
      listed, and removing one fails until its line is deleted — which is the point at which a
      breaking change becomes a deliberate versioning decision rather than an accident.
    -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt"/>
    </ItemGroup>

</Project>
