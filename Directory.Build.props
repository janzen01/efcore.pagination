<Project>

    <!-- Compilation -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Code quality -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- CS1591 (missing XML doc comment) is deliberately NOT suppressed: GenerateDocumentationFile ships the
             .xml inside every package, so an undocumented public member is a shipped defect and fails the build.
             The non-packable test project scopes the suppression in its own csproj — a PropertyGroup here cannot
             be conditioned on IsPackable, since MSBuild evaluates all properties before the project body. -->
        <!-- Audit transitive dependencies too, not just direct ones (the default). -->
        <NuGetAuditMode>all</NuGetAuditMode>
        <!-- Warnings are errors here, and the publish workflow builds again, so an advisory
             published at the wrong moment fails the release itself. Report from moderate up;
             a low-severity advisory deep in the graph is not worth blocking a publish on. -->
        <NuGetAuditLevel>moderate</NuGetAuditLevel>
        <!-- AnalysisMode is left at Default, whose enabled set contains no Security rule at all, so the
             required merge gate carried no security analysis: CodeQL is the only one that runs and sits
             outside ci-ok on purpose, reporting after a merge is already possible rather than before.
             Measured at zero diagnostics across src and test, so turning the whole category up costs
             nothing today and its value is prospective - CA2100 on a raw-SQL escape hatch, say. The
             wider AnalysisMode levels are deliberately NOT taken: Recommended and All were measured at
             roughly 85 % false positives here, largely CA1062 made redundant by Nullable=enable and a
             CA1034 that misfires on C# 14 extension blocks. -->
        <AnalysisModeSecurity>All</AnalysisModeSecurity>
    </PropertyGroup>

    <!-- Package identity (PackageId and Description are set per project) -->
    <PropertyGroup>
        <Version>10.0.3</Version>
        <Product>Janzen.Pagination</Product>
        <Authors>Lubos Jansky</Authors>
        <Copyright>Copyright © Lubos Jansky</Copyright>
    </PropertyGroup>

    <!-- Source control / Source Link (defines RepositoryUrl used below) -->
    <PropertyGroup>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/janzen01/efcore.pagination</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <!-- Deterministic source-path normalization for CI builds (.NET SDK has built-in SourceLink for GitHub). -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Package metadata (NuGet listing) -->
    <PropertyGroup>
        <!-- The documentation site (GitHub Pages, built from master /docs), not the repository: this is the
             "Project website" link on nuget.org. The repository stays reachable there as "Source repository",
             which comes from RepositoryUrl above. -->
        <PackageProjectUrl>https://janzen01.github.io/efcore.pagination/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Shared by all four packages. The value is the path inside the package, not in the repo:
             assets/icon.png is packed to the package root. NuGet only accepts a raster icon
             (NU5045), so assets/icon.svg is the master and the PNG is what ships. -->
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>$(RepositoryUrl)/releases</PackageReleaseNotes>
        <PackageTags>pagination;filtering;sorting;efcore;entity-framework-core;linq;query</PackageTags>
    </PropertyGroup>

    <!--
      Package validation: `dotnet pack` compares each package's public API against the previous released
      version and fails on an accidental break. It complements the Public API analyzers rather than
      duplicating them — those guard the intent declared in PublicAPI.Shipped.txt, this guards the packed
      assembly, including target framework and dependency changes the source files never mention.

      A deliberate break is not a defect here: record it in the project's CompatibilitySuppressions.xml,
      which then reads as the breaking-change inventory for the release. Bump the baseline at every stable
      release (see CLAUDE.md, *Releasing*) — leave it behind and the guard silently validates against an
      ever-older surface.

      Not conditioned on IsPackable: a PropertyGroup here is evaluated before the project body sets it (the
      same ordering the ItemGroups below rely on in reverse), so the test project opts out in its own csproj.
    -->
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>10.0.3</PackageValidationBaselineVersion>
    </PropertyGroup>

    <!-- Package output (symbols) -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Embedded PDBs rather than a .snupkg on nuget.org's symbol server. The debug information travels inside
             the assembly, so stepping into these sources needs nothing configured on the consumer's side: no symbol
             server enabled, no separate download, and it works offline. Settling "what does this overload actually
             do" by decompiling the shipped package is the failure this removes.
             The two are mutually exclusive: an embedded PDB leaves no .pdb file for IncludeSymbols to pack. -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Packaging: each packable project ships its own README.md as the NuGet readme, and they all
         share the single icon from the repo root ($(MSBuildThisFileDirectory)). -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!--
      Public API tracking: the declared surface lives in PublicAPI.Shipped.txt (released) and
      PublicAPI.Unshipped.txt (added since). Adding a public member fails the build until it is
      listed, and removing one fails until its line is deleted — which is the point at which a
      breaking change becomes a deliberate versioning decision rather than an accident.
    -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt"/>
    </ItemGroup>

</Project>
