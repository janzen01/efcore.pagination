<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Provider-agnostic, configuration-driven pagination, filtering and sorting engine for Entity Framework Core, with a fluent per-entity configuration API and an opinionated query-string contract.</Description>
        <PackageTags>$(PackageTags);paginate;searching;dynamic-query;data-access</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Janzen.Pagination.AspNetCore"/>
        <InternalsVisibleTo Include="Janzen.Pagination.PostgreSql"/>
        <!-- Value conversion is the one engine detail with no observable behaviour to assert against: a parsed
             DateTime's Kind changes no comparison in memory and no SQL SQLite emits, yet it shifts the instant on a
             provider that converts to UTC. The test project reaches PaginateValueConverter directly for that. -->
        <InternalsVisibleTo Include="Janzen.Pagination.Tests"/>
    </ItemGroup>

</Project>
