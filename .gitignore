# Docs
# docs/ stays deny-by-default: anything dropped in there is local planning unless it is named below.
# The site itself is the VitePress project, and a source file that is not covered here is invisible
# to the build, which then publishes a site missing that page without failing.
docs/*
!docs/src/
!docs/.vitepress/
!docs/scripts/
!docs/package.json
!docs/.npmrc
!docs/pnpm-lock.yaml

# Build output and tooling, which the site does not ship.
# docs/archive/ is generated by docs/scripts/sync-archive.mjs before every dev server and build: one copy of
# the site per released line, read out of that line's git tag. Already covered by `docs/*` above and named
# here anyway, because a directory full of pages that is deliberately absent from git reads as an oversight
# otherwise. Keeping it generated is the point -- committed, it would put a second copy of every page in the
# tree for every line ever released, and every search across the repository would have to learn to skip them.
docs/archive/
docs/.dist/
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# JetBrains IDEs
**/.idea/**/workspace.xml
**/.idea/**/shelf/
**/.idea/**/httpRequests/
**/.idea/**/dataSources/
**/.idea/**/dataSources.local.xml
**/.idea/**/contentModel.xml
**/.idea/**/projectSettingsUpdater.xml
**/.idea/**/copilot*
**/.idea/**/git_toolbox*.xml
# Per-developer run configurations (the shared .idea project settings above stay tracked)
.run/

# Local settings / secrets
**/local.settings.json
**/appsettings.local.json
**/appsettings.*.local.json
**/settings.local.json
secrets.json
.env
*.snk
*.pfx
*.pem
*.key

# Codex hooks
**/.codex/hooks.json

# Graphify output
**/graphify-out/

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

